{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001 --turbopack",
    "build": "pnpm --filter @repo/db db:generate && next build",
    "start": "next start -p 3001",
    "assets:upload-defaults": "tsx scripts/upload-default-assets-to-s3.ts",
    "db:seed": "tsx --env-file=../../.env scripts/seed.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "@hookform/resolvers": "^7.0.3",
    "@prisma/client": "^7.10.1",
    "@repo/admin": "workspace:*",
    "@repo/auth": "workspace:*",
    "@repo/crud": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/email": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-query": "^5.106.1",
    "@trpc/client": "^11.25.0",
    "@trpc/react-query": "^11.25.0",
    "@trpc/server": "^11.25.0",
    "bcryptjs": "^3.0.3",
    "next": "^16.4.5",
    "next-auth": "^4.24.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "sharp": "0.35.5",
    "superjson": "^2.2.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
